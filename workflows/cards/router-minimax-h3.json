    {
      "nodeId": "input",
      "fieldName": "base_video",
      "fieldType": "VIDEO",
      "label": "Base Video",
      "defaultValue": "None",
      "slot": "driving_video"
    },
    {
      "nodeId": "input",
      "fieldName": "reference_audio",
      "fieldType": "AUDIO",
      "label": "Reference Audio",
      "defaultValue": "None"
    }
