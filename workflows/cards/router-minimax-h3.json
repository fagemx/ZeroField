{
  "card_id": "router-minimax-h3",
  "label": "Comfy Router \u00b7 minimax/minimax-h3",
  "output_mode": "video",
  "engine_config": {
    "driver": "comfy_router",
    "model": "minimax/minimax-h3",
    "api_key_env": "COMFY_API_KEY",
    "media_origins": [],
    "timeout": 600
  },
  "nodes": [
    {
      "nodeId": "input",
      "fieldName": "prompt",
      "fieldType": "STRING",
      "label": "Prompt",
      "defaultValue": "Describe the shot",
      "slot": "prompt",
      "required": true
    },
    {
      "nodeId": "input",
      "fieldName": "duration",
      "fieldType": "INT",
      "label": "Duration",
      "defaultValue": "5",
      "slot": "duration",
      "min": 4,
      "max": 15,
      "required": true
    },
    {
      "nodeId": "input",
      "fieldName": "resolution",
      "fieldType": "LIST",
      "label": "Resolution",
      "defaultValue": "768P",
      "options": [
        "768P",
        "2K"
      ]
    },
    {
      "nodeId": "input",
      "fieldName": "ratio",
      "fieldType": "LIST",
      "label": "Ratio",
      "defaultValue": "16:9",
      "options": [
        "16:9",
        "9:16",
        "1:1",
        "4:3",
        "3:4",
        "21:9"
      ]
    },
    {
      "nodeId": "input",
      "fieldName": "first_frame",
      "fieldType": "IMAGE",
      "label": "First Frame",
      "defaultValue": "None"
    },
    {
      "nodeId": "input",
      "fieldName": "reference_image",
      "fieldType": "IMAGE",
