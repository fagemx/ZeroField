{
  "card_id": "rh-cloud-h3-burst",
  "label": "RunningHub Cloud H3 Burst",
  "sublabel": "Cloud template · Verify deployed WebApp input mapping before use",
  "output_mode": "video",
  "engine_config": {
    "driver": "runninghub_cloud",
    "provider": "runninghub",
    "tier": "cloud_burst",
    "requires_comfyui": false,
    "webappId": "2109942725885075459",
    "base_url_env": "RUNNINGHUB_API_URL",
    "api_key_env": "RUNNINGHUB_API_KEY",
    "fallback_open_card_id": "h3-short-video-v3",
    "timeout": 600,
    "cost_weight": 3,
    "concurrency_limit": 10
  },
  "nodes": [
    {
      "nodeId": "27",
      "fieldName": "video",
      "fieldType": "VIDEO",
      "label": "Source Reference Video",
      "required": true,
      "slot": "driving_video",
      "defaultValue": "None"
    },
    {
      "nodeId": "51",
      "fieldName": "image",
      "fieldType": "IMAGE",
      "label": "Character & Scene Sheet",
      "required": true,
      "slot": "ref",
      "defaultValue": "None"
    },
    {
      "nodeId": "49",
      "fieldName": "image",
      "fieldType": "IMAGE",
      "label": "Supplementary Ref 1",
      "required": false,
      "slot": "ref",
      "defaultValue": "None"
    },
    {
      "nodeId": "50",
      "fieldName": "image",
      "fieldType": "IMAGE",
      "label": "Supplementary Ref 2",
      "required": false,
      "slot": "ref",
      "defaultValue": "None"
    },
    {
      "nodeId": "43",
      "fieldName": "image",
      "fieldType": "IMAGE",
      "label": "Supplementary Ref 3",
      "required": false,
      "slot": "ref",
      "defaultValue": "None"
    },
    {
      "nodeId": "19",
      "fieldName": "image",
      "fieldType": "IMAGE",
      "label": "Supplementary Ref 4",
      "required": false,
      "slot": "ref",
      "defaultValue": "None"
    },
    {
      "nodeId": "23",
      "fieldName": "image",
      "fieldType": "IMAGE",
      "label": "Supplementary Ref 5",
      "required": false,
      "slot": "ref",
      "defaultValue": "None"
    },
    {
      "nodeId": "263",
      "fieldName": "text",
      "fieldType": "STRING",
      "label": "Generation Instruction",
      "required": true,
      "slot": "prompt",
      "defaultValue": "Use the character identity and scene environment from the reference images, and transfer the physical motion, timing, and camera trajectory from Reference Video 1.",
      "projectDefaults": {
        "default": "Cinematic 35mm film photography, natural skin texture, coherent directional lighting, clean silhouette separation, zero temporal flicker."
      }
    },
    {
      "nodeId": "259",
      "fieldName": "value",
      "fieldType": "FLOAT",
      "label": "Duration (Seconds)",
      "required": true,
      "slot": "duration",
      "defaultValue": "5",
      "min": 1,
      "max": 15,
      "step": 0.001
    },
    {
      "nodeId": "252",
      "fieldName": "aspect_ratio",
      "fieldType": "LIST",
      "label": "Aspect Ratio",
      "required": true,
      "slot": "aspect_ratio",
      "defaultValue": "16:9 (Widescreen)",
      "options": [
        "1:1 (Square)",
        "2:3 (Portrait Photo)",
        "3:2 (Photo)",
        "3:4 (Portrait Standard)",
        "4:3 (Standard)",
        "9:16 (Portrait Widescreen)",
        "16:9 (Widescreen)",
        "21:9 (Ultrawide)"
      ]
    }
  ]
}
